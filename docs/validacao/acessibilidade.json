  "incompleteManualReview": [
    {
      "category": "Logotipo Ciência Delas",
      "finding": "Letras isoladas da marca E/L/A são sinalizadas como texto curto inconclusivo.",
      "resolution": "Mantida identidade visual do logotipo, exceção de contraste de texto do WCAG 1.4.3. Grupo tem role=img e nome acessível; letras internas são decorativas. Isto não significa que as cores atendem 4,5:1 em texto comum."
    },
    {
      "category": "Links de navegação e filtros em faixa horizontal",
      "finding": "Axe não calcula fundo de links parcialmente fora da área rolável de 360px.",
      "resolution": "Revisado CSS: mesmos tokens text-muted/text-accent dos links visíveis, em bg/surface. A faixa rola dentro de seu contêiner e não provoca rolagem horizontal da página."
    },
    {
      "category": "Legenda do calendário",
      "finding": "Nav transparente sobrepõe geometricamente a região da legenda do mês.",
      "resolution": "Revisado CSS: legenda usa text-fg em bg-surface; sem fundo opaco na nav. Calendário conferido aberto nos dois temas, dias de 44px."
    },
    {
      "category": "Posições no ranking",
      "finding": "A rodada em tema claro capturou aria-label em span genérico antes da correção.",
      "resolution": "Corrigido por texto sr-only e numeral aria-hidden. Tema escuro após a correção sem inconclusivos de aria-prohibited-attr; E2E principal também valida o ranking."
    },
    {
      "category": "Textos dos carimbos SVG",
      "finding": "Axe não determina fundo de text/textPath em SVG. Revisão encontrou contraste baixo em algumas cores de categoria.",
      "resolution": "Textos passaram a fill var(--fg), círculos preservam cores da marca. Verificação adicional direta em claro/escuro, 11 carimbos por tema; valores calculados e contraste conferidos. Nome acessível inclui categoria, código, data e hora."
    }
  ],

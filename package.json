{
  "name": "passaporte-virtual",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docker:up": "docker compose up --build --renew-anon-volumes",
    "docker:down": "docker compose down",
    "db:migrate": "docker compose exec api node ace migration:run",
    "db:rollback": "docker compose exec api node ace migration:rollback",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}

{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "quoteProps": "consistent",
  "bracketSpacing": true,
  "arrowParens": "always",
  "printWidth": 100,
  "useTabs": false,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "apps/web/**",
      "options": {
        "tailwindStylesheet": "./apps/web/src/app/globals.css"
      }
    }
  ]
}
